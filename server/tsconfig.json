{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "baseUrl": "src",
    "paths": {
      "@calculators/*": ["calculators/*"],
      "@entities/*": ["entities/*"],
      "@events/*": ["events/*"],
      "@game/*": ["game/*"],
      "@reducers/*": ["reducers/*"],
      "@server-api/*": ["server/api/*"],
      "@server-websocket/*": ["server/websocket/*"],
      "@server/*": ["server/*"],
      "@structures/*": ["structures/*"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }]
}

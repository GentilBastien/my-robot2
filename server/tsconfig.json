{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "baseUrl": "./src",
    "paths": {
      "@entities/*": ["entities/*"],
      "@events/*": ["events/*"],
      "@managers/*": ["managers/*"],
      "@resolvers/*": ["resolvers/*"],
      "@resolvers-request/*": ["resolvers/request-state-cases/*"],
      "@resolvers-response/*": ["resolvers/response-state-cases/*"],
      "@states/*": ["states/*"],
      "@handlers/*": ["event-handlers/*"],
      "@structures/*": ["structures/*"],
      "@reducers/*": ["reducers/*"],
      "@utils/*": ["utils/*"]
    },
    "esModuleInterop": true
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }]
}

{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@entities/*": ["entities/*"],
      "@events/*": ["events/*"],
      "@managers/*": ["managers/*"],
      "@resolvers/*": ["resolvers/*"],
      "@resolvers-request/*": ["resolvers/request-state-cases/*"],
      "@resolvers-response/*": ["resolvers/response-state-cases/*"],
      "@states/*": ["states/*"],
      "@handlers/*": ["event-handlers/*"],
      "@structures/*": ["structures/*"],
      "@reducers/*": ["reducers/*"]
    },
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true
  },
  "include": ["src"]
}

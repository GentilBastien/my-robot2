{
  "name": "my-robot2",
  "version": "1.0.0",
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "build": "tsc -b shared server/tsconfig.build.json && npm run alias",
    "clean": "tsc -b --clean shared server/tsconfig.build.json && rimraf server/dist && rimraf shared/dist",
    "rebuild": "npm run clean && npm run build",
    "alias": "tsc-alias -p shared/tsconfig.json && tsc-alias -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "test": "vitest run && npm run alias"
  },
  "main": "index.js",
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
